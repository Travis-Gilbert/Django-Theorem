SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*

# Local default is SQLite when DATABASE_URL is unset.
# DATABASE_URL=postgres://theorem_control:changeme@localhost:5432/theorem
# VALKEY_URL=redis://127.0.0.1:6379/0
# Leave VALKEY_URL/REDIS_URL unset for in-memory tenant_cache (tests).

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=test-webhook-secret

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

RUNPOD_API_KEY=
RUNPOD_SERVERLESS_ENDPOINT_ID=
# RUNPOD_WORKER_IMAGE_DIGEST=registry.example/theorem-offload@sha256:...
RUNPOD_EXTRACTION_ENDPOINT_ID=
# RUNPOD_EXTRACTION_IMAGE_DIGEST=ghcr.io/travis-gilbert/theorem-extraction@sha256:...
# OFFLOAD_EXECUTION_MODE=runpod
# RUNPOD_JOB_TIMEOUT_SECONDS=900
# RUNPOD_POLL_INTERVAL_SECONDS=5

THEOREM_API_BASE=http://127.0.0.1:8080
THEOREM_MACHINE_KEY=
THEOREM_MACHINE_KEY_PASSAGES=

# R_OFFLOAD_EXECUTION_MODE=rpy2
# RENV_LOCKFILE_PATH=/app/renv.lock

DISABLE_SERVER_SIDE_CURSORS=True
CONN_MAX_AGE=0
CELERY_TASK_ALWAYS_EAGER=False
COMPETENCE_STALE_AFTER_SECONDS=900
COMPETENCE_SWEEP_BATCH_SIZE=100
COMPETENCE_SWEEP_INTERVAL_SECONDS=3600
EXTRACTION_MAX_INPUT_BYTES=16777216
EXTRACTION_SWEEP_INTERVAL_SECONDS=300

# Deterministic graph layout and bounded rendering.
LAYOUT_CACHE_TTL_SECONDS=86400
LAYOUT_MEMORY_CACHE_MAX_ENTRIES=1024
LAYOUT_SUBPROCESS_TIMEOUT_SECONDS=8
LAYOUT_MAX_OUTPUT_BYTES=4194304
RENDER_SUBPROCESS_TIMEOUT_SECONDS=12
RENDER_CPU_SECONDS=10
RENDER_MEMORY_BYTES=2147483648
RENDER_MAX_SOURCE_BYTES=262144
RENDER_OUTPUT_MAX_BYTES=16777216
PLANTUML_JAR_PATH=/opt/plantuml/plantuml.jar
PLANTUML_VERSION=1.2026.6
PLANTUML_SECURITY_PROFILE=SANDBOX
